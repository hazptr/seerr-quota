{
  "name": "seerr-quota",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
