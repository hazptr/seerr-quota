# seerr-quota — environment configuration.
#
# Copy to `.env` (git-ignored, not committed) and fill in real values.
# Precedence for every non-secret setting is env -> config.yaml -> built-in
# default (wiki/Configuration.md); secrets are ALWAYS env-only and must never
# be placed in config.yaml, the DB, or a commit (AGENTS.md rule 7).
#
# This file lists every secret and endpoint from wiki/Configuration.md.
# Runtime settings that live in the `app_setting` table (default_quota_bytes,
# enforcement_enabled, grace_bytes, delete_recent_play_days,
# stale_snapshot_max_age_s, delete_max_per_hour, hold_max_days,
# notify_cooldown_s) can also be seeded here — see wiki/Configuration.md for
# their defaults; DEFAULT_QUOTA_BYTES deliberately has NO default and should
# stay unset until you've decided what the default quota should be.
#
# Secret requiredness (checked at boot — src/lib/config.ts's validateConfig):
#   - SEERR_API_KEY / RADARR_API_KEY / SONARR_API_KEY / AUTHENTIK_TOKEN /
#     SEERR_WEBHOOK_SECRET are UNCONDITIONALLY required — the app can't do
#     its job without any of these four APIs + the webhook.
#   - JELLYFIN_API_KEY is required ONLY when JELLYFIN_PLAYBACK_SOURCE=rest,
#     which is the default. The legacy `db` source reads Jellyfin's own
#     SQLite file instead and needs no key — see JELLYFIN_PLAYBACK_SOURCE
#     below.
#   - SMTP_USER / SMTP_PASS are required ONLY when ENFORCEMENT_ENABLED=true.
#     Pure accounting sends no mail and needs no SMTP credentials at all;
#     enforcement does, because D-4a (wiki/Feature-05-Enforcement.md) makes
#     this app's own hold-notification email the ONLY way a held member
#     learns why — Seerr's approve/decline API carries no reason.
#   - ADMIN_USERS / AUTHENTIK_URL / APP_URL are UNCONDITIONALLY required —
#     none of them has a sane generic default to ship.

# --- Secrets (.env only — never config.yaml, never committed) --------------

# Seerr: Settings -> General -> API Key
SEERR_API_KEY=changeme-seerr-api-key

# Radarr: Settings -> General -> Security -> API Key
RADARR_API_KEY=changeme-radarr-api-key

# Sonarr: Settings -> General -> Security -> API Key
SONARR_API_KEY=changeme-sonarr-api-key

# From the Jellyfin admin UI -> API Keys (create a dedicated one for this app)
JELLYFIN_API_KEY=changeme-jellyfin-api-key

# A DEDICATED, read-only Authentik service token (an `authentik_token`
# resource if you manage Authentik via terraform) — NOT your own admin token.
AUTHENTIK_TOKEN=changeme-authentik-service-token

# Generated (e.g. `openssl rand -hex 32`); also pasted into Seerr's webhook
# custom header (Settings -> Notifications -> Webhook) so the receiver can
# verify the request actually came from Seerr.
SEERR_WEBHOOK_SECRET=changeme-seerr-webhook-secret

# SMTP relay credentials, for member hold/unhold notifications (D-4a,
# FR-ENF-13). Required ONLY when ENFORCEMENT_ENABLED=true below — leave
# unset while running accounting-only.
SMTP_USER=changeme-smtp-user
SMTP_PASS=changeme-smtp-pass

# --- Upstream endpoints (defaults shown; override only if different) -------

SEERR_URL=http://jellyseerr:5055
RADARR_URL=http://radarr:7878
SONARR_URL=http://sonarr:8989
JELLYFIN_URL=http://jellyfin:8096
# rest = Jellyfin's own REST API, via JELLYFIN_API_KEY below — the default.
# db   = legacy fallback: a read-only open of Jellyfin's SQLite file. Still
#        supported, but NOT recommended: Jellyfin's DB is live WAL-mode
#        SQLite, and opening it read-only from a `:ro` single-file bind mount
#        fails in WAL mode ("attempt to write a readonly database"), which
#        makes playback-state lookups fail, which fail-closed blocks every
#        deletion (see docker-compose.yml / JELLYFIN_DB_PATH). Only use this
#        if you can't issue a dedicated Jellyfin API key.
JELLYFIN_PLAYBACK_SOURCE=rest
AUTHENTIK_URL=https://auth.example.com
# This app's own public URL — appears in member-notification email and in
# Seerr's own chrome (the in-Seerr quota banner, FR-BAN-6). Not a constant.
APP_URL=https://quota.example.com
# This app's own Authentik application slug, for the entitlement-drift check
# against SEERR_APP_SLUG below (FR-ADM-9). Not the same thing as jellyseerr's slug.
SELF_APP_SLUG=seerr-quota
SEERR_APP_SLUG=jellyseerr

# Any SMTP relay reachable from this container (Proton Bridge, a local
# Postfix/MSA, your provider's SMTP, etc.) — see wiki/Deployment.md.
# SMTP_PORT 25 assumes STARTTLS on the container-visible port.
SMTP_HOST=mail.example.com
SMTP_PORT=25
# Should read as this app, not Seerr — see wiki/Feature-05-Enforcement.md
# "Open questions".
SMTP_FROM=quota@example.com

# --- Identity ----------------------------------------------------------------

ADMIN_USERS=admin
ADMIN_GROUP=admins

# --- Runtime settings (DB-backed; these env vars only SEED app_setting on ---
# --- first boot — after that the operator-edited DB value wins) ------------

# No default. Leave unset until the operator has decided the number (P0-5) —
# accounting still runs and enforcement stays off regardless of
# ENFORCEMENT_ENABLED while this is unset.
# DEFAULT_QUOTA_BYTES=500000000000

ENFORCEMENT_ENABLED=false
GRACE_BYTES=0
DELETE_RECENT_PLAY_DAYS=14
# Window for the "in_progress" delete guard (someone partway through, not yet
# finished) — deliberately much wider than DELETE_RECENT_PLAY_DAYS above.
DELETE_IN_PROGRESS_DAYS=90
STALE_SNAPSHOT_MAX_AGE_S=3600
DELETE_MAX_PER_HOUR=25
# 0 = never auto-decline a held request.
HOLD_MAX_DAYS=30
# Min gap between hold-notification emails to one member.
NOTIFY_COOLDOWN_S=86400

# --- Scheduling --------------------------------------------------------------

RECONCILE_INTERVAL=15m
RECONCILE_ON_BOOT=true
WEBHOOK_ENABLED=true
UPSTREAM_TIMEOUT=20s
UPSTREAM_RETRIES=2

# --- Scheduled deletion (FR-DEL-22 ... FR-DEL-28) --------------------------
# How long a confirmed file deletion stays cancellable before it actually
# runs. The member who scheduled it, or the operator, can call it off at any
# point in this window from the app's own UI.
#
#   0  = no window; confirming deletes on the next sweep (the original
#        behaviour, before a grace period existed). Supported, but it
#        removes the self-service undo.
#   negative = refused at boot (it would execute everything immediately while
#        the UI still promised a window).
DELETE_GRACE_PERIOD=24h

# How often the sweeper looks for deletions whose grace period has elapsed.
# Only bounds how late an execution can be, never how early. Must be positive.
DELETE_SWEEP_INTERVAL=5m

# --- Paths ---------------------------------------------------------------

# Bind-mounted — see docker-compose.yml.
DB_PATH=/db/seerr-quota.db
# Read-only mount for free-space reporting (FR-ADM-2) — see docker-compose.yml.
MEDIA_FREE_SPACE_PATH=/mnt/media
# Only used when JELLYFIN_PLAYBACK_SOURCE=db — a read-only bind mount of
# Jellyfin's SQLite DB, the legacy fallback for playback state. Ignored
# entirely under the default `rest` source.
JELLYFIN_DB_PATH=/jellyfin-db/jellyfin.db
LOG_LEVEL=info

# --- Display -------------------------------------------------------------

TZ=UTC
# decimal (GB = 10^9, FR-ACCT-9) or binary. Must stay consistent app-wide.
SIZE_UNITS=decimal
