# seerr-quota — forward-auth example: Authentik embedded outpost (nginx/SWAG)
#
# Reference text only — NOT applied automatically. This is the Authentik
# flavour of wiki/Deployment.md's forward-auth section; adapt names/paths to
# your own SWAG/nginx config. Since 0.2.0 this app has NO Authentik-specific
# code at all — it only ever reads whatever headers AUTH_USER_HEADER/
# AUTH_GROUPS_HEADER/AUTH_EMAIL_HEADER are configured to (defaults
# Remote-User/Remote-Groups, AUTH_EMAIL_HEADER UNSET/disabled — see below),
# so this snippet is just "how to get Authentik to populate those headers,"
# nothing seerr-quota-specific.
#
# Assumes SWAG's bundled `authentik-server.conf` / `authentik-location.conf`
# includes (or your own equivalent forward-auth location block hitting
# Authentik's embedded outpost `/outpost.goauthentik.io/auth/nginx`).

server {
    listen 443 ssl;
    server_name quota.*;
    include /config/nginx/ssl.conf;
    include /config/nginx/authentik-server.conf;

    # Unauthenticated liveness for Gatus (FR-SSO-6) — must BYPASS the gate.
    location = /healthz {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app seerr-quota;
        set $upstream_port 3000;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }

    location / {
        include /config/nginx/authentik-location.conf;
        # The two headers this app reads by default — names match
        # AUTH_USER_HEADER/AUTH_GROUPS_HEADER's defaults. Change the
        # proxy_set_header NAME here (left-hand side) if you've configured
        # this app with different header names; $authentik_username/
        # $authentik_groups are Authentik's own nginx variables, set by the
        # included forward-auth location.
        proxy_set_header Remote-User   $authentik_username;
        proxy_set_header Remote-Groups $authentik_groups;

        # OPT-IN ONLY (security review, PR #17) — do NOT uncomment this
        # unless you have BOTH (a) confirmed AUTH_EMAIL_HEADER=Remote-Email
        # is explicitly set in this app's .env (it is UNSET/disabled by
        # default), AND (b) confirmed Authentik's outpost response actually
        # carries an email claim your `authentik-location.conf` maps into a
        # `$authentik_email` variable — this is NOT guaranteed by every
        # SWAG/Authentik version out of the box; check your include file. If
        # EITHER is false, the email-fallback feature stays safely
        # disabled and this line should stay commented out. The underlying
        # Authentik outpost header is `X-authentik-email`, not
        # `Remote-Email` — your include must already be mapping that into
        # the nginx variable below before this line can do anything useful.
        #
        # proxy_set_header Remote-Email $authentik_email;

        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app seerr-quota;
        set $upstream_port 3000;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}

# The Seerr webhook does NOT traverse this vhost — Seerr reaches the app
# directly over the shared Docker network (FR-SSO-7); see wiki/Deployment.md.
#
# Whichever headers you DO configure here, your proxy MUST overwrite every
# one of them, UNCONDITIONALLY, on every request — a header your config
# only sets "when present" (rather than always replacing the incoming
# value) can be forged by whoever controls the client, defeating FR-SSO-4.
