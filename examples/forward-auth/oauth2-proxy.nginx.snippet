# seerr-quota — forward-auth example: oauth2-proxy in front of any OIDC IdP (nginx)
#
# Reference text only — NOT applied automatically. oauth2-proxy's own
# `auth_request` integration returns `X-Auth-Request-User` /
# `X-Auth-Request-Email` / `X-Auth-Request-Groups` from its `/oauth2/auth`
# endpoint, but each needs an explicit oauth2-proxy flag to actually be
# populated — see the oauth2-proxy.cfg notes below before copying this.
# This snippet maps THOSE onto the headers seerr-quota reads — either
# rename them in your `AUTH_*_HEADER` env vars to match oauth2-proxy's
# names directly, or (as shown here) proxy_set_header a rename so you can
# keep this app's defaults.
#
# oauth2-proxy.cfg notes (security review, PR #17):
#   - `set_xauthrequest = true` is what makes oauth2-proxy emit
#     `X-Auth-Request-User`/`-Email`/`-Groups` on the `/oauth2/auth`
#     subrequest response AT ALL — without it these headers never appear
#     and the proxy_set_header lines below silently forward blank values.
#   - `X-Auth-Request-User`'s content depends on `--user-id-claim` (default
#     `sub` — an opaque subject identifier, NOT a human-readable username).
#     Most IdPs: set `--user-id-claim=preferred_username` (OIDC) so this
#     header actually carries a stable, human login name, OR use
#     `X-Auth-Request-Preferred-Username` directly (oauth2-proxy sets this
#     separately from `--set-xauthrequest` when the claim is available) —
#     pick ONE and verify what it actually contains before relying on it.
#   - Groups do NOT come from `--pass-user-headers` (that controls headers
#     passed to the UPSTREAM app bypassing this auth_request/subrequest
#     pattern entirely, not what `/oauth2/auth` returns to nginx). You need
#     BOTH `--set-xauthrequest` AND your OIDC provider configured with a
#     groups claim/scope (`--oidc-groups-claim=groups`, plus whatever scope
#     your IdP requires to actually populate that claim) for
#     `X-Auth-Request-Groups` to carry anything.

server {
    listen 443 ssl;
    server_name quota.*;
    include /config/nginx/ssl.conf;

    # Unauthenticated liveness for Gatus (FR-SSO-6) — must BYPASS the gate.
    location = /healthz {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app seerr-quota;
        set $upstream_port 3000;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }

    # The internal auth_request subrequest target.
    location = /oauth2/auth {
        internal;
        proxy_pass       http://oauth2-proxy:4180;
        proxy_set_header  Host             $host;
        proxy_set_header  X-Real-IP        $remote_addr;
        proxy_set_header  X-Scheme         $scheme;
        proxy_set_header  Content-Length   "";
        proxy_pass_request_body off;
    }

    # REQUIRED — without this, /oauth2/sign_in (the error_page target below)
    # and the OIDC callback both 404 against the seerr-quota upstream
    # instead of reaching oauth2-proxy, so login never completes (a
    # sign-in/callback loop). Every oauth2-proxy nginx example needs this
    # location; it is easy to drop by only copying the two blocks above.
    location /oauth2/ {
        proxy_pass       http://oauth2-proxy:4180;
        proxy_set_header  Host             $host;
        proxy_set_header  X-Real-IP        $remote_addr;
        proxy_set_header  X-Scheme         $scheme;
    }

    location / {
        auth_request /oauth2/auth;
        auth_request_set $oauth2_user   $upstream_http_x_auth_request_user;
        auth_request_set $oauth2_email  $upstream_http_x_auth_request_email;
        auth_request_set $oauth2_groups $upstream_http_x_auth_request_groups;
        error_page 401 = /oauth2/sign_in;

        # Map oauth2-proxy's own header names onto the three this app reads
        # (defaults — rename both sides if you've changed AUTH_*_HEADER).
        proxy_set_header Remote-User   $oauth2_user;
        proxy_set_header Remote-Groups $oauth2_groups;
        proxy_set_header Remote-Email  $oauth2_email;
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app seerr-quota;
        set $upstream_port 3000;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}

# The Seerr webhook does NOT traverse this vhost — Seerr reaches the app
# directly over the shared Docker network (FR-SSO-7); see wiki/Deployment.md.
#
# `Remote-Email` above is shown only as a MAPPING EXAMPLE — this app's
# AUTH_EMAIL_HEADER fallback defaults to DISABLED (see wiki/Configuration.md
# and wiki/Feature-01-SSO-Identity.md). Only set AUTH_EMAIL_HEADER if you
# have verified `X-Auth-Request-Email` is actually populated (requires
# `--set-xauthrequest` AND an email scope/claim from your IdP) and that this
# exact proxy_set_header line is reached on EVERY request through this
# vhost — an email header your proxy does not unconditionally overwrite is
# a spoofable identity input.
