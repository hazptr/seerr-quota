# seerr-quota — forward-auth example: Authelia (nginx)
#
# Reference text only — NOT applied automatically. Assumes Authelia's own
# documented nginx `auth_request` snippet is already set up elsewhere in
# your proxy config (the usual `/authelia/authz/...` internal location that
# calls Authelia's `/api/authz/auth-request` endpoint and sets
# $remote_user/$remote_groups/$remote_email via `auth_request_set`). This
# file shows only the vhost side for seerr-quota: wiring those nginx
# variables into the three headers this app reads.

server {
    listen 443 ssl;
    server_name quota.*;
    include /etc/nginx/ssl.conf;

    # Unauthenticated liveness for Gatus (FR-SSO-6) — must BYPASS the gate.
    location = /healthz {
        proxy_pass http://seerr-quota:3000;
    }

    location / {
        # Authelia's forward-auth subrequest + the auth_request_set lines
        # that populate $remote_user/$remote_groups/$remote_email — see
        # Authelia's own nginx integration docs for the auth_request block
        # itself; only the header mapping below is seerr-quota-specific.
        include /etc/nginx/snippets/authelia-location.conf;

        proxy_set_header Remote-User   $remote_user;
        proxy_set_header Remote-Groups $remote_groups;
        proxy_set_header Remote-Email  $remote_email;
        proxy_pass http://seerr-quota:3000;
    }
}

# The Seerr webhook does NOT traverse this vhost — Seerr reaches the app
# directly over the shared Docker network (FR-SSO-7); see wiki/Deployment.md.
